---
name: slb-registration-test

templates:
  run.erb: bin/run

packages:
- jq
- aliyuncli


properties:
  load_balancer_id:
    description: The id of the SLB with which the errand should be registered
  ecs_region:
    description: The Alicloud region in which the errand is run
  access_key:
    description: Alibaba Cloud access key id of a short-lived assumed-role credential
  secret_key:
    description: Alibaba Cloud access key secret of a short-lived assumed-role credential
  security_token:
    description: STS token of the short-lived assumed-role credential

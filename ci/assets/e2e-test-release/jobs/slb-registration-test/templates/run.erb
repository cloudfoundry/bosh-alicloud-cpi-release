#!/usr/bin/env bash
set -e -o pipefail

export PATH=$(readlink -nf /var/vcap/packages/jq):/usr/local/bin:/var/vcap/packages/aliyuncli/bin/:${PATH}

slb_id=<%= p('load_balancer_id') %>
region=<%= p('ecs_region') %>
key=<%= p('access_key') %>
secret=<%= p('secret_key') %>
token=<%= p('security_token') %>

echo "fetching instance ID"
instance_id=$(curl http://100.100.100.200/latest/meta-data/instance-id)
echo "instance id: $instance_id"

echo "checking if our instance $instance_id is registered with $slb_id"
# A short-lived assumed-role credential, not a long-lived access key. The errand
# VM is deliberately given no RAM role: attaching one would require the
# director's CPI to hold ram:PassRole.
aliyun slb DescribeLoadBalancerAttribute --LoadBalancerId "$slb_id" --access-key-id $key --access-key-secret $secret --sts-token $token --region $region | jq --arg instance_id $instance_id -e '.BackendServers.BackendServer[0] | select(.ServerId == $instance_id)'
